# >>> Jobs CocoaPods network >>>
jobs_pod_scripts_dir = File.expand_path('ScriptsByPods', __dir__)
# 同步准备当前安装进程的网络链路，让选源和后续源码下载继承同一配置。
jobs_pod_network_dir = File.join(jobs_pod_scripts_dir, '【MacOS】🌐CocoaPods网络适配.command')
jobs_pod_network_path = File.join(jobs_pod_network_dir, 'jobs_cocoapods_network.rb')
begin
  if File.file?(jobs_pod_network_path)
    require jobs_pod_network_path
    JobsCocoaPodsNetwork.apply!(project_root: __dir__)
  else
    warn '[PodNetwork] 网络适配模块缺失，沿用当前网络；请迁移完整脚本包。'
  end
rescue LoadError, SyntaxError, StandardError => error
  warn "[PodNetwork] 网络适配不可用，沿用当前网络（#{error.class}）。"
end

# 只在真实安装入口注册已核验依赖的官方归档回退，不改变依赖声明和版本。
jobs_pod_dependency_command = File.basename($PROGRAM_NAME) == 'pod' &&
  %w[install update].include?(ARGV.find { |argument| !argument.start_with?('-') })
if jobs_pod_dependency_command
  jobs_pod_download_fallback_path = File.join(jobs_pod_network_dir, 'jobs_cocoapods_download_fallback.rb')
  begin
    if File.file?(jobs_pod_download_fallback_path)
      require jobs_pod_download_fallback_path
      JobsCocoaPodsDownloadFallback.install!
    else
      warn '[PodNetwork] 官方源码归档回退模块缺失，继续使用 CocoaPods 原下载器。'
    end
  rescue LoadError, SyntaxError, StandardError => error
    warn "[PodNetwork] 官方源码归档回退不可用，继续原下载流程（#{error.class}）。"
  end
end

# 源选择必须同步完成，才能影响本次依赖解析。
jobs_specs_source_path = File.join(
  jobs_pod_scripts_dir,
  '【MacOS】🌐CocoaPods源自动选择.command',
  'jobs_cocoapods_source.rb'
)
begin
  if File.file?(jobs_specs_source_path)
    require jobs_specs_source_path
    JobsCocoaPodsSource.apply!(self, project_root: __dir__)
  else
    warn '[SpecsSource] 选源模块缺失，使用官方 CDN。请迁移完整脚本包。'
    source 'https://cdn.cocoapods.org/'
  end
rescue LoadError, SyntaxError, StandardError => error
  warn "[SpecsSource] 选源模块异常，使用官方 CDN：#{error.message}"
  source 'https://cdn.cocoapods.org/'
end
# <<< Jobs CocoaPods network <<<

require 'fileutils'

platform :ios, '15.0'

install! 'cocoapods',
  :disable_input_output_paths => true,
  :warn_for_unused_master_specs_repo => false
use_frameworks! :linkage => :static
inhibit_all_warnings!

target 'RepairMarketplace' do
  dependency_file = File.join(__dir__, 'Podfile.deps')
  raise "缺少依赖清单：#{dependency_file}" unless File.file?(dependency_file)
  instance_eval(File.read(dependency_file), dependency_file, 1)
end

post_install do |installer|
  project_path = installer.pods_project.path
  backup_path = "#{project_path}.repair-backup"
  FileUtils.cp(project_path, backup_path) if File.file?(project_path)

  begin
    project = installer.pods_project
    root_uuid = project.root_object.uuid
    dependency_path = '../Podfile.deps'
    dependency_refs = project.main_group.files.select do |file|
      file.path == dependency_path
    end
    raise 'Podfile.deps 根组中存在重复引用' if dependency_refs.length > 1

    file_ref = dependency_refs.first
    file_ref ||= project.main_group.new_file(dependency_path)
    file_ref.explicit_file_type = 'text.script.ruby'
    project.targets.each do |target|
      target.build_configurations.each do |configuration|
        configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
        configuration.build_settings['SWIFT_VERSION'] = '5.0'
      end
    end
    project.save

    reopened = Xcodeproj::Project.open(project_path)
    dependency_refs = reopened.main_group.files.select do |file|
      file.path == dependency_path
    end
    dependency_ref_found = dependency_refs.length == 1 &&
      dependency_refs.first.explicit_file_type == 'text.script.ruby'
    build_phase_refs = reopened.targets.flat_map(&:build_phases).flat_map do |phase|
      phase.respond_to?(:files_references) ? phase.files_references : []
    end
    dependency_ref_in_build_phase = build_phase_refs.any? do |file|
      file.path == dependency_path && file.explicit_file_type == 'text.script.ruby'
    end
    unless reopened.root_object.isa == 'PBXProject' &&
        reopened.root_object.uuid == root_uuid &&
        dependency_ref_found &&
        !dependency_ref_in_build_phase
      raise 'Podfile.deps 引用写入后核验失败'
    end
  rescue StandardError => error
    begin
      FileUtils.cp(backup_path, project_path) if File.file?(backup_path)
    rescue StandardError => restore_error
      warn "[Podfile.deps] Pods 工程恢复失败：#{restore_error.message}"
    end
    warn "[Podfile.deps] Xcode 展示引用维护失败，已跳过：#{error.message}"
  ensure
    FileUtils.rm_f(backup_path)
  end
end
